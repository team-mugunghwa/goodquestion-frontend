# 저장소에는 항상 LF로 저장합니다.
#
# 이게 없으면 Windows 팀원이 커밋한 파일이 CRLF로 들어가서,
# Mac 팀원이 열었을 때 "전체 파일이 바뀐 것"처럼 diff가 뜹니다.
# .editorconfig(에디터용)와 짝을 이루는 git용 설정입니다.
* text=auto eol=lf

# 텍스트로 다뤄야 하는 파일 (명시)
*.dart      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.xml       text eol=lf
*.gradle    text eol=lf
*.kt        text eol=lf
*.java      text eol=lf
*.swift     text eol=lf
*.h         text eol=lf
*.m         text eol=lf
*.plist     text eol=lf
*.pbxproj   text eol=lf
.gitignore  text eol=lf

# Windows 전용 스크립트는 CRLF 유지 (LF면 실행이 깨짐)
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 바이너리 — 절대 변환하지 않음
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.jar       binary
*.keystore  binary
*.jks       binary
*.pdf       binary

# 생성 코드 — GitHub diff에서 접어서 보여줌 (리뷰 노이즈 감소)
*.g.dart    linguist-generated=true
pubspec.lock linguist-generated=true
