    "PERSPECTIVE",
    "EMPATHY"
   ],
   "scene": 5,
   "character": "시아버지",
   "engine": "gemini-2.5-flash-preview-tts",
   "voice": "Puck",
   "duration": 7.811
  },
  {
   "id": "c5_PERSPECTIVE",
   "file": "c5_PERSPECTIVE.mp3",
   "text": "며느리는 그동안 눈치 보면서 계속 참기만 했을 거예요.",
